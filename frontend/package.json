{
  "name": "turb-console-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "generate:labels": "python3 ../tools/maintenance/generate_task_error_labels.py",
    "check:labels": "python3 ../tools/maintenance/generate_task_error_labels.py --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run check:api && npm run check:labels && npm run typecheck && vite build",
    "check": "npm run check:api && npm run check:labels && npm run typecheck && npm test"
  },
  "dependencies": {
    "reka-ui": "2.11.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.4.11",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
