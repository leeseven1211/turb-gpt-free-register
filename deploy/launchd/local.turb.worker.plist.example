<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.turb.INSTANCE.worker</string>
	<key>ProgramArguments</key>
	<array>
		<string>/ABSOLUTE/PROJECT/.venv/bin/python</string>
		<string>/ABSOLUTE/PROJECT/worker.py</string>
		<string>--shutdown-timeout</string>
		<string>55</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/ABSOLUTE/PROJECT</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>TURB_RUNTIME_MODE</key>
		<string>worker</string>
		<key>TURB_RUNTIME_MANAGER</key>
		<string>launchd</string>
		<key>TURB_INSTANCE_ID</key>
		<string>INSTANCE</string>
		<key>TURB_RUNTIME_DIR</key>
		<string>/ABSOLUTE/RUNTIME</string>
		<key>TASK_RUN_LOG_ROOT</key>
		<string>/ABSOLUTE/TASK_LOGS</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/ABSOLUTE/LOGS/worker.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/ABSOLUTE/LOGS/worker.stderr.log</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<key>Umask</key>
	<integer>63</integer>
</dict>
</plist>
