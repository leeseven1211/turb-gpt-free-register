[Unit]
Description=Turb execution role (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=turb
Group=turb
WorkingDirectory=/srv/turb/%i/current
EnvironmentFile=/etc/turb/%i/bootstrap.env
Environment=PYTHONUNBUFFERED=1
Environment=TURB_RUNTIME_MODE=worker
Environment=TURB_RUNTIME_MANAGER=systemd
Environment=TURB_INSTANCE_ID=%i
Environment=TURB_RUNTIME_DIR=/var/lib/turb/%i/runtime
Environment=TASK_RUN_LOG_ROOT=/var/log/turb/%i/tasks
ExecStart=/srv/turb/%i/current/.venv/bin/python /srv/turb/%i/current/worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
