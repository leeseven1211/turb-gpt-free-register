__pycache__/
# 不带斜杠：`.venv/` 只匹配目录，符号链接会漏网被 git 跟踪
.venv
.venv/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.playwright-mcp/
.playwright-cli/
output/playwright/
# HAR 工具的兼容默认输出属于本地诊断产物
/docs/reference/protocol-har-summary.json
.mypy_cache/
.ruff_cache/
.superpowers

# 历史调试输出（_xxx.out / _xxx_dump.html）
tools/_*.out
tools/_*.html
tools/_*.py
!tools/test_codex_oauth.py

# Sentinel runner 临时 challenge 文件
sentinel-challenge-*.json

# Sentinel 本地调试配置（可能含 Cookie/Bearer/Challenge）
sentinel.config.json
tools/sentinel.config.json
sentinel/sentinel.config.json

