# Copy to .env and fill values. Never commit .env
#   cp .env.example .env

# 所有 WebUI 可编辑配置都使用 .env 覆盖 config/*.py 默认值。

# ---- 系统设置 / 网站配置 ----
# WebUI 登录授权码；仅保存在 .env，避免出现在进程命令行中
WEBUI_AUTH_CODE=
# 可选：Session Cookie 签名密钥；留空时从固定授权码派生，修改授权码会使已有登录失效
WEBUI_SESSION_SECRET=


# ---- 注册设置 / 注册主链路 ----
# 注册驱动默认值：roxy=本地 Roxy，roxy_oss=开源 Roxy，protocol=本地优化 Protocol，protocol_oss=开源 Protocol，protocol_oss_2=开源protocol-2
REGISTRATION_DRIVER=
# 注册国家：ISO 两位代码；注册按此国家向统一代理池申请，独立于池默认国家
# 旧配置缺少此字段时沿用原有效默认国家；显式配置后不再跟随池默认国家
REGISTRATION_COUNTRY=JP
# 注册认证方式：otp=不设置密码、使用邮箱一次性验证码；password=设置并保存账号密码（仍可能需要邮箱 OTP）
REGISTRATION_AUTH_MODE=otp
# password 模式点击“继续”后，独立等待进入验证码页/登录态的最长秒数
REGISTRATION_PASSWORD_TRANSITION_TIMEOUT_SECONDS=60
# 注册核心保存后是否自动独立查询套餐；关闭后仍可在账号管理中手动查询
REGISTRATION_PLAN_CHECK_ENABLED=True
# 显示名称: 留空则自动生成英文名
REGISTER_NAME=

# 启用 2FA(TOTP)：注册完成后自动设置动态口令（会多收一封 OTP 邮件）
ENABLE_2FA=
# 2FA 开通方式：auto=自动选择（协议优先）；protocol=协议开通并按现有流程回退；browser=直接走 RoxyBrowser 安全设置页面
TWOFA_DRIVER=auto
# 重认证总尝试次数与首次退避秒数；OTP 临时 403/429 复用原会话，不重复发码
TWOFA_REAUTH_MAX_ATTEMPTS=3
TWOFA_REAUTH_RETRY_DELAY=3.0

# 启用 Codex OAuth：注册成功后自动跑 Codex 授权（全新session+接码），落盘 codex-邮箱.json
ENABLE_CODEX_AUTO=
# Codex 授权驱动：protocol=纯协议，roxy=浏览器，same_as_registration=跟随注册驱动（开源方式分别映射到 protocol / roxy）
CODEX_OAUTH_DRIVER=

# 启用 Flow 触发：注册成功后自动调用内部 Flow 接口（不影响注册结果）
ENABLE_FLOW_TRIGGER=

# ---- 系统设置 / 通用配置 ----
ACCOUNT_BATCH_WORKERS=3

# ---- 系统设置 / 定时任务：Codex Token 管理 ----
# Codex OAuth access token 自动刷新（使用 refresh_token，不重新跑授权）
CODEX_TOKEN_AUTO_REFRESH_ENABLED=True
CODEX_TOKEN_REFRESH_BEFORE_HOURS=24
CODEX_TOKEN_REFRESH_SCAN_INTERVAL_SECONDS=86400
CODEX_TOKEN_REFRESH_INITIAL_DELAY_SECONDS=120
CODEX_TOKEN_REFRESH_MAX_PER_CYCLE=20
# 曾由当前页面上传过 sub2api 的凭证，在 token 刷新后同步更新
CODEX_TOKEN_AUTO_SYNC_SUB2API=True

# ---- PostgreSQL 主存储（使用本机 shared-services/postgres 公共实例）----
DATABASE_URL=

# ---- 系统设置 / 任务中心历史保留 ----
# 每天自动归档并清理超过此天数的明确终态任务；0 关闭自动清理
TASK_CENTER_RETENTION_DAYS=7
# 清理前生成的脱敏本地归档保留天数；0 表示永久保留归档
TASK_CENTER_ARCHIVE_RETENTION_DAYS=30

# ---- 注册设置 / 注册调试（每次是否开启由注册页“调试模式”决定） ----
# 普通模式失败时也保存轻量脱敏诊断；不会抓取成功请求或暂停浏览器
REGISTRATION_FAILURE_DIAGNOSTICS_ENABLED=
REGISTRATION_FAILURE_DIAGNOSTICS_RESOURCE_LIMIT=
REGISTRATION_FAILURE_DIAGNOSTICS_TEXT_MAX_KB=
# 最终失败后保留 Roxy 浏览器现场的秒数
REGISTRATION_DEBUG_HOLD_TIMEOUT_SECONDS=
# 同时允许暂停保留的失败现场数量
REGISTRATION_DEBUG_MAX_HELD_SESSIONS=
# 单个文本/JSON 正文、单任务正文总量和所有抓包目录的上限
REGISTRATION_DEBUG_BODY_MAX_KB=
REGISTRATION_DEBUG_BODY_BUDGET_MB=
REGISTRATION_DEBUG_GLOBAL_BUDGET_MB=
# 调试抓包默认保留天数
REGISTRATION_DEBUG_RETENTION_DAYS=
# 单任务异步抓包写入队列长度；队列满时丢弃事件并计数，不阻塞注册主流程
REGISTRATION_DEBUG_QUEUE_SIZE=

# ---- 浏览器设置 / RoxyBrowser ----
# Roxy API 地址: 本项目默认 http://127.0.0.1:50100；需与 Roxy 应用 API 配置一致
ROXY_API_BASE=
# Roxy API Key: 保存在 .env（ROXY_API_TOKEN），不写回 config/*.py
ROXY_API_TOKEN=
# Roxy 环境ID: 指定要打开的 Roxy 浏览器环境/Profile ID；留空则尝试创建临时环境
ROXY_PROFILE_ID=
# Roxy 工作区ID: 创建一号一环境时必填，会作为 workspaceId 提交给 Roxy 创建 Profile 接口
ROXY_WORKSPACE_ID=
# Roxy 项目ID: 从 /browser/workspace 的 project_details.projectId 获取；创建 Profile 时会作为 projectId 提交
ROXY_PROJECT_ID=
# 获取团队接口: 默认 /browser/workspace；点击获取团队/项目时会先试此路径，再自动尝试常见兼容路径
ROXY_WORKSPACE_LIST_PATH=
# 打开接口路径: 默认 /browser/open；如 Roxy 版本不同可在此调整
ROXY_OPEN_PATH=
# 创建环境间隔: 多线程时相邻 /browser/create 请求的最小间隔，默认 1.5 秒；设为 0 可关闭
ROXY_CREATE_INTERVAL=
# 无头启动窗口: 打开 Roxy 环境时向 /browser/open 传 headless；False=显示窗口，True=无头启动
ROXY_OPEN_HEADLESS=
# Codex OAuth 专用无头开关: 默认 False=显示窗口；与注册流程的 ROXY_OPEN_HEADLESS 独立
ROXY_CODEX_OPEN_HEADLESS=
# 关闭接口路径: 默认 /browser/close
ROXY_CLOSE_PATH=
# 保留浏览器: 调试时可开启，任务结束后不自动关闭 Roxy 环境
ROXY_KEEP_BROWSER_OPEN=
# 窗口忙等待上限(秒): 仅等待 /browser/open 临时窗口忙，create Profile 总额度不足会立即失败，默认 900 秒
ROXY_WINDOW_WAIT_TIMEOUT=
# 窗口忙重试间隔(秒): 等待 /browser/open 临时窗口忙状态时的重试间隔，默认 10 秒
ROXY_WINDOW_WAIT_INTERVAL=
# 一号一环境: 每个账号最多绑定一个 Roxy Profile；没有绑定时才创建新环境
ROXY_ONE_PROFILE_PER_ACCOUNT=
# 复用账号环境: 注册续跑和账号级浏览器操作优先打开账号绑定的 Profile
ROXY_REUSE_ACCOUNT_PROFILE=
# 结束后删除环境: 高风险开关，默认关闭；开启后删除本轮新建的 Profile（即使已绑定账号）
ROXY_DELETE_PROFILE_AFTER_RUN=
# 创建环境使用代理池: 仅用于手动地址；API 供应商任务租约会自动写入 Roxy proxyInfo，并优先于此开关
ROXY_CREATE_USE_PROXY_POOL=
# 代理检测通道: 写入 Roxy proxyInfo.checkChannel；留空则不传，默认 IPRust.io
ROXY_PROXY_CHECK_CHANNEL=
# 删除接口路径: 默认 /browser/delete；如 Roxy 版本不同可调整
ROXY_DELETE_PATH=
# 以下字段由 config.schema 的 WebUI editable schema 生成
ROXY_RANDOM_OS_ON_CREATE=True
ROXY_RANDOM_OS_CHOICES=Windows,macOS
ROXY_RANDOM_PROFILE_NAME_ON_CREATE=True
ROXY_PROFILE_NAME_PREFIX=rb

# Codex回调超时: Roxy Codex OAuth 等待 localhost:1455 callback 的最长秒数
ROXY_CODEX_CALLBACK_TIMEOUT=

# ---- 账号补全 ----
# “补全账号”只处理当前缺失项；刷新 AT 仍是独立操作，默认不隐式调用
ACCOUNT_COMPLETION_PASSWORD_ENABLED=True
ACCOUNT_COMPLETION_PLAN_CHECK_ENABLED=True
ACCOUNT_COMPLETION_2FA_ENABLED=True
ACCOUNT_COMPLETION_CODEX_ENABLED=True
ACCOUNT_COMPLETION_REFRESH_AT_ENABLED=False
# 协议换绑邮箱总开关；关闭后 API 和任务提交会拒绝新换绑任务
ACCOUNT_EMAIL_CHANGE_ENABLED=True
# 换绑前的最小账号年龄；默认 24 小时，防止远端以账号过新拒绝并浪费邮箱租约；0 表示关闭
ACCOUNT_EMAIL_CHANGE_MIN_ACCOUNT_AGE_HOURS=24
# 账号补全登录时是否允许点击“忘记密码”并通过邮箱验证码设置新密码；默认关闭
ACCOUNT_PASSWORD_RESET_ENABLED=False
# 账号补全各能力的执行驱动：密码仅 roxy；套餐仅 protocol；2FA 可 protocol/browser；Codex 可 protocol/roxy/same_as_registration
ACCOUNT_PASSWORD_DRIVER=roxy
ACCOUNT_PLAN_CHECK_DRIVER=protocol
# 可选 protocol_current / browser_roxy；browser_roxy 还需显式开启下面的灰度开关
ACCOUNT_LIVE_CHECK_DRIVER=protocol_current
ACCOUNT_LIVE_CHECK_BROWSER_ENABLED=False
# 协议版本：只有同时支持 v1/v2 的步骤读取；单版本步骤自动使用唯一实现
OPENAI_PROTOCOL_VERSION=v1
# 密码明确错误后是否另起一次会话发送邮箱 OTP；默认关闭，不会重试错误密码
ACCOUNT_AUTH_PASSWORD_EMAIL_FALLBACK=False
# current 保持每个会话随机画像；account_stable 仅对 v2 协议刷新懒创建账号级 Protocol 画像
ACCOUNT_AUTH_PROFILE_MODE=current
# 原始认证上下文默认不保存；开启后按白名单写入受限私有 run context
ACCOUNT_AUTH_RAW_CONTEXT_ENABLED=False
ACCOUNT_AUTH_RAW_CONTEXT_RETENTION_DAYS=30
# 账号补全 2FA：auto=按 AT/协议重认证/浏览器会话自动选择；protocol=协议开通并按兜底开关回退；browser=直接浏览器
ACCOUNT_2FA_DRIVER=auto
# auto/protocol 协议开通失败后是否允许回退到 Roxy 安全设置页；默认开启，保障旧能力可用
ACCOUNT_2FA_BROWSER_FALLBACK_ENABLED=True
# auto/protocol 缺少新鲜 AT 或遇到 MFA 401 时是否先走协议邮箱重认证换取新 AT；默认开启
ACCOUNT_2FA_PROTOCOL_REAUTH_ENABLED=True
ACCOUNT_CODEX_DRIVER=same_as_registration
# v1 协议刷新失败后的既有 Roxy 登录兜底；不影响普通查活
LIVE_CHECK_ROXY_FALLBACK_ENABLED=True

# ---- 浏览器设置 / 人工节奏 ----
# 启用随机停顿: 在注册、OTP、授权等步骤之间加入随机等待，更接近人工操作节奏
ENABLE_HUMANIZE_DELAY=
# 停顿倍率: 随机停顿整体倍率；1.0=默认，0.5=减半，2.0=加倍
HUMANIZE_DELAY_FACTOR=
# schema-generated: 浏览器动作级人工节奏开关
ENABLE_HUMANIZE_BROWSER_ACTIONS=True

# ---- 邮箱 / OTP ----
# 自动取邮箱+收码: True=从邮箱池自动领邮箱并自动收 OTP；False=手动模式：用 REGISTER_EMAIL，OTP 在任务页手填
USE_EMAIL_SERVICE=
# 手动注册邮箱: USE_EMAIL_SERVICE=False 时必填。例如你的 outlook.com 地址；OTP 去网页邮箱看，再回任务页提交
REGISTER_EMAIL=
# OTP 最长等待(秒): 单轮等待验证码邮件的最长秒数；Email Butler/iCloud 转发建议 240，避免过早重发
OTP_MAX_WAIT=
# OTP 轮询间隔(秒): 每隔多少秒查一次新邮件
OTP_POLL_INTERVAL=
# WebUI 可选邮箱来源列表: 可填单个或多个并用逗号分隔；开始注册时必须明确选择一个，任务不会跨平台兜底
# 可用值: outlook,generic_api,cloudflare_domain,cloudflare,email_butler,gptmail,mailnest,remail,cloudmail,icloud_hide
EMAIL_SOURCE=
# 邮箱子地址：按来源能力生成 +随机后缀，旧任务始终继续原地址
EMAIL_DERIVATION_ENABLED=False
# 允许派生的来源，可用逗号多选 icloud_hide,outlook；实际收码能力由后端检查
EMAIL_DERIVATION_SOURCES=icloud_hide
# 每个母邮箱累计生成额度；后续提高此值即可继续派生
EMAIL_DERIVATION_MAX_CHILDREN=3
EMAIL_DERIVATION_TAG_LENGTH=6
# Outlook取件模式: auto=远端优先，远端 402/DEPLOYMENT_DISABLED 自动切 Graph 直连；direct=只用 Microsoft Graph 直连；remote=只用远端服务
OUTLOOK_FETCH_MODE=
# Outlook 远端取件服务根地址（remote/auto 时使用）
OUTLOOK_API_BASE=https://mail.chatai.codes
# 仅 cloudflare_domain：Email Routing 转发域名，如 mydomain.com（与 EMAIL_SOURCE=cloudflare 无关）
EMAIL_DOMAIN=
# 仅 cloudflare_domain：接收 Email Routing 转发的 QQ 邮箱，如 123456@qq.com
QQ_EMAIL=
# 仅 cloudflare_domain：QQ 邮箱 IMAP 授权码（不写回 config/*.py）
QQ_IMAP_PASSWORD=
# GPTMail API Key: 选择 EMAIL_SOURCE=gptmail 时必填；服务地址固定为 https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=

# Email Butler 通用 /v1 Mail API（EMAIL_SOURCE 含 email_butler 时）
EMAIL_BUTLER_API_BASE=
EMAIL_BUTLER_API_KEY=
EMAIL_BUTLER_REQUEST_TIMEOUT=20
# 封号邮件后台扫描：默认开启；仅扫描 Email Butler / Cloudflare 来源
# 开关与间隔可在 WebUI「配置 → 系统设置 → 定时任务」里改，无需重启。上次执行时间存在数据库，
# 重启服务会按剩余时间接续，不会重复执行。
EMAIL_BUTLER_RISK_SCAN_ENABLED=True
# 封号邮件扫描并发与其它账号操作统一使用 ACCOUNT_BATCH_WORKERS
EMAIL_BUTLER_RISK_SCAN_INTERVAL_SECONDS=21600
EMAIL_BUTLER_RISK_SCAN_INITIAL_DELAY_SECONDS=90
EMAIL_BUTLER_RISK_SCAN_LOOKBACK_DAYS=120

# ChatGPT accessToken 生命周期管理：JWT 到期前自动通过邮箱登录刷新。
AT_AUTO_REFRESH_ENABLED=True
AT_REFRESH_BEFORE_HOURS=24
AT_REFRESH_SCAN_INTERVAL_SECONDS=3600
AT_REFRESH_INITIAL_DELAY_SECONDS=120
AT_REFRESH_MAX_PER_CYCLE=20

# Cloudflare Worker 临时邮箱（EMAIL_SOURCE 含 cloudflare 时；与 cloudflare_domain/QQ IMAP 不同）
# Worker API 根地址，例如 https://mail.example.com（不要末尾多余路径）
CLOUDFLARE_API_BASE=
# 匿名可空；admin 模式填 ADMIN_PASSWORD
CLOUDFLARE_API_KEY=
# 封号邮件只读信号接口专用 Key（建议与创建邮箱 Key 分离）
CLOUDFLARE_SIGNAL_API_KEY=
# 封号邮件只读信号接口路径
CLOUDFLARE_SIGNAL_PATH=/signals/scan
# none / bearer / x-api-key / x-admin-auth / query-key；admin 推荐 x-admin-auth
CLOUDFLARE_AUTH_MODE=
# Worker 全局密码，注入请求头 x-custom-auth；无则留空
CLOUDFLARE_CUSTOM_AUTH=
# 创建邮箱路径: 默认 /api/new_address；admin 创建常用 /admin/new_address
CLOUDFLARE_PATH_ACCOUNTS=
# 邮件列表路径: 默认 /api/mails
CLOUDFLARE_PATH_MESSAGES=
# 默认收信域名，逗号分隔，例如 mail.example.com；可留空由 Worker 决定
CLOUDFLARE_DEFAULT_DOMAINS=
# HTTP 请求超时秒数，默认 20
CLOUDFLARE_REQUEST_TIMEOUT=
# admin 创建时随机 local-part 长度，默认 10
CLOUDFLARE_NAME_LENGTH=
# MailNest-迈巢 Outlook 临时邮箱的 api key 获取页面 https://mailnest.top/account
MAIL_NEST_API_KEY=
# MailNest 项目代码：默认 chatgpt001
MAIL_NEST_PROJECT_CODE=
# Remail 开放 API 根地址，默认 https://remail.aishop6.com
REMAIL_API_BASE=
# Remail 控制台生成的 API Key，EMAIL_SOURCE 含 remail 时必填
REMAIL_API_KEY=
# ChatGPT/OpenAI 验证码项目 ID，默认 2；以平台项目列表为准
REMAIL_PROJECT_ID=
# 下单邮箱后缀，默认 outlook.com
REMAIL_EMAIL_SUFFIX=
# purchase=长效购买；code=短效接码。默认 purchase
REMAIL_SERVICE_MODE=
# public_only=只使用公开库存；private_first=优先自己的库存。默认 public_only
REMAIL_SUPPLY_POLICY=
# 等待订单补齐收件凭证的最长秒数，默认 30
REMAIL_ORDER_WAIT_SECONDS=
# 单次 HTTP 请求超时秒数，默认 20
REMAIL_REQUEST_TIMEOUT=

# 域名邮箱 MailCode（EMAIL_SOURCE=mailcode）；服务地址固定为官网
MAILCODE_API_KEY=
MAILCODE_PRODUCT_ID=product_a3783a0ead074b4091631b9ad04153f9
MAILCODE_REQUEST_TIMEOUT=20
MAILCODE_CHANNEL_WAIT_SECONDS=60

# 西瓜邮箱（EMAIL_SOURCE=xigua）；只购买指定 Offer，原订单与幂等键存 PostgreSQL
XIGUA_API_BASE=https://xigua.dasiqo.com
XIGUA_API_KEY=
XIGUA_PROJECT_SLUG=chatgpt
XIGUA_OFFER_ID=off_79b957291b6eae5f53f2abd04ebda998
XIGUA_REQUEST_TIMEOUT=20
XIGUA_POLL_ATTEMPTS=10
XIGUA_POLL_INTERVAL=5
# CloudMail/Cloud Mail API 地址，例如 https://mail.example.com
CLOUDMAIL_API_BASE=
# CloudMail 管理员邮箱；填写账号密码后保存配置会自动获取 CLOUDMAIL_AUTH_TOKEN
CLOUDMAIL_ADMIN_EMAIL=
# CloudMail 登录密码
CLOUDMAIL_PASSWORD=
# CloudMail 生成 Token 接口路径，默认 /api/public/genToken
CLOUDMAIL_TOKEN_PATH=
# CloudMail/Cloud Mail API Authorization Token
CLOUDMAIL_AUTH_TOKEN=
# CloudMail 邮箱域名列表，每行一个
CLOUDMAIL_DOMAINS=
# 生成随机邮箱后是否自动调用 /api/public/addUser
CLOUDMAIL_AUTO_ADD_USER=
# 随机邮箱 local-part 长度
CLOUDMAIL_RANDOM_LOCAL_LENGTH=

# iCloud Hide My Email 本地 sidecar（EMAIL_SOURCE 含 icloud_hide 时）
ICLOUD_HME_API_BASE=http://127.0.0.1:8081
# sidecar 固定账号 ID；留空自动发现并同步全部 active 账号
ICLOUD_HME_ACCOUNT_ID=
# sidecar 启用鉴权时填写；仅监听 127.0.0.1 可留空
ICLOUD_HME_API_TOKEN=
ICLOUD_HME_REQUEST_TIMEOUT=35
# 别名自动同步缓存秒数
ICLOUD_HME_SYNC_TTL=300
# sidecar=iCloud IMAP；forward_imap=本机直接读取 Gmail；forward_butler=Oracle 接收 Gmail 后从 Email Butler PG 取码
ICLOUD_HME_INBOX_MODE=sidecar
ICLOUD_HME_FORWARD_IMAP_SERVER=imap.gmail.com
ICLOUD_HME_FORWARD_IMAP_PORT=993
# 必须与 Apple 返回的 forwardToEmail 完全一致
ICLOUD_HME_FORWARD_IMAP_EMAIL=
# forward_imap 模式用于本机直接读取 Gmail；填写 Gmail 应用专用密码
ICLOUD_HME_FORWARD_IMAP_PASSWORD=
# 库存为空时是否向 Apple 自动创建新别名
ICLOUD_HME_AUTO_CREATE=False
ICLOUD_HME_CREATE_LABEL_PREFIX=turb

# ---- 浏览器设置 / 浏览器画像 ----
# 地区画像: GeoIP 自动画像关闭或检测失败时使用的兜底地区；可选 jp/cn/us/sg/vn，应尽量与代理出口地区一致
BROWSER_LOCALE_PROFILE=
# 按出口IP自动画像: 开启后每个 BrowserSession 会用当前代理出口 IP 自动选择语言/时区；失败时回退到地区画像
AUTO_BROWSER_LOCALE_FROM_IP=
# IP定位超时(秒): 出口 IP 地理信息接口的单次请求超时；接口失败会自动回退，不影响注册
IP_GEO_TIMEOUT=
# Roxy 本地浏览器省流量模式；默认 False。登录保留核心 JS/CSS，完整会话保存后使用轻量页面；需要浏览器 2FA 时恢复完整资源
BROWSER_DATA_SAVER_MODE=
# 认证流程省流量范围；默认 token_refresh、live_check、codex_oauth、account_action
BROWSER_DATA_SAVER_AUTH_FLOWS=
# 每行一个资源类型；默认 image、media。font 需单独验证；script/stylesheet 自动放行
BROWSER_DATA_SAVER_BLOCKED_RESOURCE_TYPES=
# 每行一个 URL glob；留空使用内置省流量规则，填 [] 可关闭 URL 规则
BROWSER_DATA_SAVER_BLOCKED_URL_PATTERNS=
# 公共静态资源缓存：off=关闭（默认），observe=仅观察，enabled=注册及账号认证流程跨 Profile 复用公开 JS/CSS
BROWSER_PUBLIC_ASSET_CACHE_MODE=
# 公共静态缓存总容量上限，单位 MiB；默认 256，可设 16–4096
BROWSER_PUBLIC_ASSET_CACHE_MAX_MB=
# 省流量模式下，在本机中继连接供应商前屏蔽的域名；含子域名，[] 关闭。
BROWSER_DATA_SAVER_BLOCKED_PROXY_HOSTS=
# 可选资源流量日志及 JS 覆盖率诊断；默认关闭，URL 查询参数/正文不入日志。
BROWSER_TRAFFIC_DETAIL_LOG=
BROWSER_TRAFFIC_DETAIL_MAX_ENTRIES=
BROWSER_JS_COVERAGE_LOG=
BROWSER_JS_COVERAGE_MAX_ENTRIES=

# ---- 代理与网络 ----
# 注册和账号动作统一从代理池领取；1024proxy / 711proxy / manual
PROXY_POOL_SOURCE=1024proxy
# 未指定国家的池请求及缺少历史国家的账号默认国家；新注册使用 REGISTRATION_COUNTRY
# 手动地址也须通过实际出口国家检测
PROXY_POOL_DEFAULT_COUNTRY=JP
# 旧字段只用于新字段缺席时的迁移，不再控制各业务的代理来源
REGISTRATION_PROXY_MODE=
# 1024Proxy 白名单供给 API（敏感配置；完整 URL 仅放 .env；代理池按固定参数补货）
PROXY_1024_API_URL=
# 旧国家配置仅用于迁移；当前默认国家使用 PROXY_POOL_DEFAULT_COUNTRY
PROXY_1024_REGION=
# 返回代理协议: http / https / socks5 / socks5h
PROXY_1024_PROTOCOL=
# 粘性时长(分钟)，作为代理池固定供给参数；不保证每次领取都是新会话或新 IP
PROXY_1024_SESSION_MINUTES=
# 兼容旧配置项；独立代理池使用固定供给参数，不能据此保证新会话或新 IP
PROXY_1024_ROTATE_SESSION_TIME=
# API与代理检测超时、最大尝试次数
PROXY_1024_API_TIMEOUT=
PROXY_1024_MAX_ATTEMPTS=
# 整段获取硬上限(秒)，包括重复IP重取和出口检测
PROXY_1024_ACQUIRE_TIMEOUT=60
# True=领取邮箱前先检查实际出口IP
PROXY_1024_VALIDATE=
# 同一端点遇到超时/连接/SSL瞬时错误时的检测次数
PROXY_1024_VALIDATE_ATTEMPTS=2
# 任务释放后拒绝重复IP的时间(秒)，默认1800
PROXY_1024_RECENT_TTL=
# 并发任务调用提取API的最小间隔(秒)
PROXY_1024_ACQUIRE_INTERVAL=
PROXY_1024_PERSIST_LEASES=True
# 711Proxy 动态住宅按流量提取 API（敏感配置；完整 URL 仅放 .env）
PROXY_711_API_URL=
# 返回代理协议: http / socks5 / socks5h；http 支持 HTTPS 目标访问，须与供应商生成接口时一致
PROXY_711_PROTOCOL=http
# 粘性时长 1~180 分钟；固定使用粘性会话并关闭提前换 IP
PROXY_711_SESSION_MINUTES=30
# 提取 API 和出口检测的单次超时(秒)
PROXY_711_API_TIMEOUT=12
# 后台单轮补货总预算(秒)
PROXY_711_ACQUIRE_TIMEOUT=60
# 同一端点瞬时检测错误的重试次数
PROXY_711_VALIDATE_ATTEMPTS=2
# 任务释放后拒绝重复 IP 的时间(秒)
PROXY_711_RECENT_TTL=1800
# 单个进程提取 API 的最小间隔(秒)
PROXY_711_ACQUIRE_INTERVAL=0.6
# 注册浏览器遇到明确的代理瞬时错误时，释放旧租约并换线重试；不改变并发数
REGISTRATION_PROXY_RETRIES=3
REGISTRATION_PROXY_RETRY_DELAY=1
# 查活/刷新 AT 在申请代理阶段遇到重复租约时，额外换线重试；不重跑已提交的认证步骤
ACCOUNT_ACTION_PROXY_RETRIES=2
ACCOUNT_ACTION_PROXY_RETRY_DELAY=1
# 以下账号动作来源仅兼容历史配置；所有新领取都使用当前代理池来源
ACCOUNT_PASSWORD_PROXY_MODE=registration
ACCOUNT_2FA_PROXY_MODE=registration
ACCOUNT_PLAN_CHECK_PROXY_MODE=direct
# 仅代理池来源的查套餐允许复用 IP；各供应商及手动地址仍验证出口国家和健康状态
PLAN_CHECK_PROXY_ALLOW_REUSE=True
# 同一实际出口 IP 在租约有效期内最多建立的套餐查询租约数（含首次）；释放或重启不清零，达到上限后换线
PLAN_CHECK_PROXY_REUSE_LIMIT=3
# 独立查套餐额外预检 Plus 的支付方式、会话类型和应付金额；默认关闭以减少耗时与网络失败
PLAN_CHECK_PAYMENT_METHODS_ENABLED=False
# 独立账号查套餐国家列表，支持换行/逗号/空格；留空沿用账号注册国家的单次查询路径
PLAN_CHECK_COUNTRIES=JP,VN,IN
# 独立查套餐每个国家领取已验证线路的最长等待时间（5-300 秒）
PLAN_CHECK_COUNTRY_WAIT_TIMEOUT=60
ACCOUNT_LIVE_CHECK_PROXY_MODE=direct
ACCOUNT_REFRESH_AT_PROXY_MODE=registration
ACCOUNT_CODEX_PROXY_MODE=registration
# 邮箱换绑协议线路；registration=跟随注册线路，其他值与账号动作代理来源一致
ACCOUNT_EMAIL_CHANGE_PROXY_MODE=registration
# 旧字段仅兼容读取，不再决定账号动作的代理来源
ACCOUNT_ACTION_PROXY_MODE=
# 旧固定代理字段；新手动地址统一填写 PROXY_POOL
ACCOUNT_ACTION_PROXY=
# 手动来源地址，每行一个完整代理 URL；检测实际国家后统一入池
PROXY_POOL=
# 额外预热国家，不改变注册或独立查套餐国家；留空不额外预热
PROXY_POOL_COUNTRIES=
# 独立代理池策略：任务只领取后台已检测通过的库存；等待轮换占容量，冷却/历史不占
# 每个活跃来源/地区的空闲底数；如设为 5，领取后后台补足 5 条可立即领取的线路
# 最大容量需为占用线路和空闲底数预留空间；供给故障时仍可能等待
PROXY_POOL_MIN_READY=2
PROXY_POOL_MAX_SIZE=20
# 0：代理不足时持续等待，可手动停止；正数：领取总等待时间上限（秒）
PROXY_POOL_WAIT_TIMEOUT=0
# 必须小于当前 API 供应商的会话时长，并为出口检测预留时间
PROXY_POOL_MIN_TTL=300
PROXY_POOL_CHECK_INTERVAL=60
PROXY_POOL_MAX_IDLE=300
PROXY_POOL_WORKERS=2
# 旧版套餐查询兼容字段；当前查询统一通过代理池
PLAN_CHECK_PROXY_MODE=
# 旧版套餐查询兼容专用代理；可能包含认证信息
PLAN_CHECK_PROXY=
# 套餐查询请求参数（仅控制请求重试与节奏）
PLAN_CHECK_TIMEOUT=15.0
PLAN_CHECK_MAX_ATTEMPTS=2
PLAN_CHECK_RETRY_DELAY=1.5
PLAN_CHECK_REGISTRATION_RECHECK_DELAY=2.0
PLAN_CHECK_MIN_INTERVAL=0.4
PLAN_CHECK_JITTER=0.3

# ---- 提链 ----
# 提链服务 API 地址
EXTRACT_LINK_API_BASE=https://ple.bzb.qzz.io
# 提链 CDK：仅保存到 .env
EXTRACT_LINK_CDK=
# PIX / GoPay / UPI 等，实际可用类型由提链服务动态返回
EXTRACT_LINK_TYPE=pix
# 提链队列容量（修改后重启）
EXTRACT_LINK_QUEUE_LIMIT=500
# 提链请求和事件等待超时
EXTRACT_LINK_REQUEST_TIMEOUT=30
EXTRACT_LINK_EVENT_TIMEOUT=180

# 工作台：新任务默认只提取链接；自动支付与支付后操作均默认关闭
EXTRACT_LINK_ENABLED=true
EXTRACT_LINK_DEFAULT_PROVIDER=legacy
EXTRACT_LINK_DEFAULT_MODE=extract_only
# 新批次默认并发，1-16；每批可覆盖，仍受平台并发和共享执行预算限制
EXTRACT_LINK_BATCH_WORKERS=1
EXTRACT_LINK_EXTRACT_ENABLED=true
# 提链前预检；关闭后直接使用库中保存的 AT
EXTRACT_LINK_PREFLIGHT_ENABLED=true
# 需同时开启预检；仅当预检确认 AT 失效时刷新
EXTRACT_LINK_PREFLIGHT_REFRESH_AT_ENABLED=true
EXTRACT_LINK_MANUAL_PAYMENT_ENABLED=false
EXTRACT_LINK_AUTO_PAYMENT_ENABLED=false
EXTRACT_LINK_POST_PAYMENT_CHECK_ENABLED=false
EXTRACT_LINK_POST_PAYMENT_REFRESH_AT_ENABLED=false
EXTRACT_LINK_POST_PAYMENT_PLAN_CHECK_ENABLED=false
# legacy 继续复用上方 EXTRACT_LINK_API_BASE / CDK / TYPE / REQUEST_TIMEOUT / EVENT_TIMEOUT
EXTRACT_LINK_LEGACY_ENABLED=true
EXTRACT_LINK_LEGACY_EXTRACT_ENABLED=true
EXTRACT_LINK_LEGACY_MANUAL_PAYMENT_ENABLED=false
EXTRACT_LINK_LEGACY_AUTO_PAYMENT_ENABLED=false
EXTRACT_LINK_LEGACY_CONCURRENCY=1
# 新平台默认关闭，CDK 保持空值
EXTRACT_LINK_LUMEN_FLOW_ENABLED=false
EXTRACT_LINK_LUMEN_FLOW_EXTRACT_ENABLED=true
EXTRACT_LINK_LUMEN_FLOW_MANUAL_PAYMENT_ENABLED=false
EXTRACT_LINK_LUMEN_FLOW_AUTO_PAYMENT_ENABLED=false
EXTRACT_LINK_LUMEN_FLOW_CONCURRENCY=1
EXTRACT_LINK_LUMEN_FLOW_DEFAULT_TYPE=pix
EXTRACT_LINK_LUMEN_FLOW_API_BASE=
EXTRACT_LINK_LUMEN_FLOW_CDK=
EXTRACT_LINK_LUMEN_FLOW_REQUEST_TIMEOUT=30
EXTRACT_LINK_LUMEN_FLOW_POLL_INTERVAL=3
EXTRACT_LINK_LUMEN_FLOW_EVENT_TIMEOUT=180
EXTRACT_LINK_HUANGUANG_ENABLED=false
EXTRACT_LINK_HUANGUANG_EXTRACT_ENABLED=true
EXTRACT_LINK_HUANGUANG_MANUAL_PAYMENT_ENABLED=false
EXTRACT_LINK_HUANGUANG_AUTO_PAYMENT_ENABLED=false
EXTRACT_LINK_HUANGUANG_CONCURRENCY=1
EXTRACT_LINK_HUANGUANG_DEFAULT_TYPE=upi
EXTRACT_LINK_HUANGUANG_API_BASE=
# 提链任务 CDK 与自动支付扫码 CDK 分开填写；支付扫码 CDK 对应平台 chongyun_cdk
EXTRACT_LINK_HUANGUANG_CDK=
EXTRACT_LINK_HUANGUANG_PAYMENT_CDK=
# 平台后台先走幻光扫码，90 秒未接单后取消并确认退次才转 XXSYUN；缺少 Key 时不启用转单
EXTRACT_LINK_HUANGUANG_XXSYUN_API_KEY=
EXTRACT_LINK_HUANGUANG_SCAN_FALLBACK_ENABLED=false
# 每行一条完整代理 URL，去重后每侧最多 500 条；留空的侧从统一代理池领取 IN 线路
EXTRACT_LINK_HUANGUANG_ENTRY_PROXIES=
EXTRACT_LINK_HUANGUANG_EXIT_PROXIES=
EXTRACT_LINK_HUANGUANG_REQUEST_TIMEOUT=30
EXTRACT_LINK_HUANGUANG_POLL_INTERVAL=10
# 首轮监控预算；到期后释放执行槽并定时续查原单
EXTRACT_LINK_HUANGUANG_EVENT_TIMEOUT=180
# 原单自动查询总预算（含首轮监控）、无有效进展时限和连续查询失败上限
# 到期转待核验，保留原单与付款材料；不计入创建原单前的 CDK 排队时间
EXTRACT_LINK_HUANGUANG_RECONCILE_TIMEOUT=3600
EXTRACT_LINK_HUANGUANG_NO_PROGRESS_TIMEOUT=900
EXTRACT_LINK_HUANGUANG_MAX_QUERY_FAILURES=12

# ---- sub2api ----
SUB2API_API_BASE=
SUB2API_API_KEY=
SUB2API_API_TIMEOUT=20

# ---- CPA / Codex ----
# 授权地址来源: cpa=由 CPA 管理接口生成授权地址；local=旧版本地生成 PKCE 授权地址
CODEX_AUTH_URL_SOURCE=
# CPA 管理地址: 例如 http://localhost:8317/admin/oauth；程序会取 origin 调用 /v0/management/*
CPA_MANAGEMENT_URL=
# 管理密钥: 保存在 .env（CPA_MANAGEMENT_KEY），不写回 config/*.py
CPA_MANAGEMENT_KEY=
# CPA 超时(秒): 请求 CPA 管理接口的超时时间
CPA_REQUEST_TIMEOUT=
CPA_CREDENTIAL_CONFIRM_TIMEOUT=
# 保存CPA回执: CPA 未返回完整授权文件时，本地仍保存一份回调提交记录
CPA_SAVE_CALLBACK_RECEIPT=

# ---- 接码平台 ----
# 接码通道: grizzly / l / h；h 使用 H_API.md 定义的本地取号服务
SMS_PROVIDER=
# 国家代码: GrizzlySMS 可用逗号填写备用列表（如 117,2,148），无号/超价时自动切换；L/H 填单个 country
SMS_COUNTRY=
# 服务/项目代码: GrizzlySMS/L 作为 service；H 通道可复用为 projectId
SMS_SERVICE=
# 最高价格上限（不是固定成交价）: 留空=不限；实际价格以平台返回为准
SMS_MAX_PRICE=
# GrizzlySMS：每批次在价格上限内按短信成功率自动选国；失败时回退 SMS_COUNTRY
SMS_AUTO_SELECT_COUNTRY=True
# 过滤统计量太少的国家，避免“1 次成功=100%”误导
SMS_AUTO_COUNTRY_MIN_RATIO=25
# 换号重试次数: 一个号收不到短信/被OpenAI拒时换下一个号，最多重试几次
SMS_MAX_RETRIES=
# 单号等短信硬上限(秒): 超时后后台取消，不阻塞注册线程
SMS_CODE_WAIT=
# 手机验证总预算(秒): 含取号、页面操作、等短信和换号
CODEX_PHONE_TOTAL_TIMEOUT=300
# GrizzlySMS API密钥: 保存在 .env（SMS_API_KEY），不写回 config/*.py
SMS_API_KEY=
# H API 地址: H 取号服务基础地址，例如 http://localhost:8788
H_API_BASE=
# H 授权码: 保存在 .env（H_ADMIN_AUTH_CODE），不写回 config/*.py
H_ADMIN_AUTH_CODE=
# H 号码前缀: H 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
H_PHONE_PREFIX=
# H 取号方式: reusable=优先复用号码；new=每次取新号（调用 /api/admin/h/take-phone）
H_PHONE_ACQUIRE_MODE=
# L API 地址: L 取号服务基础地址，例如 http://localhost:8788
L_API_BASE=
# L 授权码: 保存在 .env（L_ADMIN_AUTH_CODE），不写回 config/*.py
L_ADMIN_AUTH_CODE=
# L 号码前缀: L 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
L_PHONE_PREFIX=
