# 仅保存启动配置与部署身份；不要提交填好后的 .env。
# 运行参数、第三方密钥和历史收码凭据在迁移后由 PostgreSQL 管理。
# 首次部署或升级：先配置数据库，再使用 tools/migrate_runtime_config.py。

# ---- 数据库启动配置 ----
DATABASE_URL=
# 仅实际生产部署明确设为 1；开发和测试保持 0。
TURB_ALLOW_PRODUCTION_DB=0
# 可选：默认 public。
# TURB_DB_SCHEMA=public
# 可选：默认 12。
# TURB_DB_POOL_MAX=12

# ---- WebUI 授权 ----
WEBUI_AUTH_CODE=
# 可选；留空时从授权码派生，已有值请保留。
WEBUI_SESSION_SECRET=

# ---- 稳定部署身份 ----
# 已有环境必须保留原值，不能因为迁移而重新生成。
TURB_MAIL_CONSUMER_ID=

# ---- 数据库配置加密 ----
# 由显式迁移工具生成；必须与数据库备份一起妥善保存，禁止随意替换。
TURB_CONFIG_ENCRYPTION_KEY=

# ---- 本机依赖路径（可选） ----
# NODE_EXECUTABLE=/absolute/path/to/node
# OPENAI_SENTINEL_NODE_PATH=/absolute/path/to/node
# CLOAK_USER_DATA_DIR=/absolute/path/to/browser-data

# HOST、PORT、OPEN_BROWSER、VERBOSE、STARTUP_CHECK_TIMEOUT 由启动命令/服务环境设置。
# TASK_RUN_LOG_ROOT 需在进程启动前通过服务环境设置，仅写此文件不会生效。
