# 仅保存启动配置与部署身份；不要提交填好后的 .env。
# 运行参数、第三方密钥和历史收码凭据在迁移后由 PostgreSQL 管理。
# 首次部署或升级：先配置数据库，再使用 tools/migrate_runtime_config.py。

# ---- 数据库启动配置 ----
DATABASE_URL=
# 仅实际生产部署明确设为 1；开发和测试保持 0。
TURB_ALLOW_PRODUCTION_DB=0
# 可选：默认 public。
# TURB_DB_SCHEMA=public
# 可选：默认 12。
# TURB_DB_POOL_MAX=12

# ---- WebUI 授权 ----
WEBUI_AUTH_CODE=
# 可选；留空时从授权码派生，已有值请保留。
WEBUI_SESSION_SECRET=

# ---- 稳定部署身份 ----
# 已有环境必须保留原值，不能因为迁移而重新生成。
TURB_MAIL_CONSUMER_ID=

# ---- 部署浏览器能力 ----
# 本机缺省开启；Oracle 纯协议实例设为 false。只允许启动配置，不能在 WebUI 修改。
TURB_BROWSER_ENABLED=true

# ---- 注册驱动运行配置参考 ----
# 在“配置 → 注册与账号 → 注册主链路”保存；仅支持 roxy / protocol_oss_2。
# 历史 protocol、protocol_oss 自动使用 protocol_oss_2；历史 roxy_oss 自动使用 roxy。
# REGISTRATION_DRIVER=roxy
# 密码策略固定为页面有入口就优先使用；旧 otp 配置读取为 password，无入口时仍可继续邮箱验证。
# REGISTRATION_AUTH_MODE=password

# ---- 账号补密码运行配置参考 ----
# 在“配置 → 注册与账号 → 账号补全”保存到运行配置数据库，默认仍为 roxy。
# protocol 给已有账号添加密码，无需浏览器；账号页“修改密码”仍使用 Roxy。
# ACCOUNT_PASSWORD_DRIVER=roxy
# 纯协议实例可选择 protocol；已有正式密码的账号会跳过补密码。

# ---- AT 刷新运行配置参考 ----
# 在“配置 → 注册与账号 → 账号补全 → 刷新 AT 策略”保存，默认保持 v1。
# v3 支持加密登录会话复用、连续认证挑战、MFA 和工作区兼容；仅作用于 AT 刷新。
# ACCOUNT_AT_REFRESH_DRIVER=protocol
# OPENAI_PROTOCOL_VERSION=v1
# 可选 v1 / v2 / v3；选择 browser_roxy 时不读取协议版本。

# ---- 数据库配置加密 ----
# 由显式迁移工具生成；必须与数据库备份一起妥善保存，禁止随意替换。
TURB_CONFIG_ENCRYPTION_KEY=

# ---- 本机依赖路径（可选） ----
# NODE_EXECUTABLE=/absolute/path/to/node
# OPENAI_SENTINEL_NODE_PATH=/absolute/path/to/node
# 实验功能默认关闭，通过 WebUI 运行配置保存；仅匹配原有匿名登录页预检。
# OPENAI_CF_PREFLIGHT_ENABLED=false
# CLOAK_USER_DATA_DIR=/absolute/path/to/browser-data

# HOST、PORT、OPEN_BROWSER、VERBOSE、STARTUP_CHECK_TIMEOUT 由启动命令/服务环境设置。
# TASK_RUN_LOG_ROOT 需在进程启动前通过服务环境设置，仅写此文件不会生效。

# ---- 暗光（XXSYUN 一条龙）运行配置参考 ----
# 以下字段请在“配置 → 提链 → 暗光（XXSYUN 一条龙）”保存到运行配置数据库。
# 不要将密钥填入此示例。必须单独配置一条虫 Key，普通扫码 Key 不受理，也不会迁移或复制。
# 平台必自动扫码，不能关闭；仅支持 auto_payment / UPI，支付来源固定 native。
# EXTRACT_LINK_ANGUANG_ENABLED=false
# EXTRACT_LINK_ANGUANG_AUTO_PAYMENT_ENABLED=false
# EXTRACT_LINK_ANGUANG_API_BASE=https://ytc.xxsyun.xyz/openapi/v1
# EXTRACT_LINK_ANGUANG_API_KEY=
# EXTRACT_LINK_ANGUANG_CONCURRENCY=1
# EXTRACT_LINK_ANGUANG_REQUEST_TIMEOUT=30
# EXTRACT_LINK_ANGUANG_POLL_INTERVAL=10
# EXTRACT_LINK_ANGUANG_PROCESSING_MODE=STANDARD
# EXTRACT_LINK_ANGUANG_PLAN_NAME=chatgptplusplan
# EXTRACT_LINK_ANGUANG_AUTO_RETRY=false

# ---- sub2api 同步与巡检运行配置参考 ----
# 在“配置 → Codex → sub2api”和“系统设置 → 定时任务”保存到运行配置数据库。
# 以下均为可选项，留空保留远端配置；不要在示例中填写管理员密钥。
# SUB2API_UPLOAD_GROUP_IDS=
# SUB2API_UPLOAD_PROXY_ID=
# SUB2API_UPLOAD_CONCURRENCY=
# SUB2API_UPLOAD_PRIORITY=
# SUB2API_UPLOAD_LOAD_FACTOR=
# SUB2API_UPLOAD_MODELS=
# SUB2API_SYNC_RETRY_ENABLED=false
# SUB2API_MONITOR_ENABLED=false
# SUB2API_MONITOR_INTERVAL_SECONDS=300
# SUB2API_MONITOR_COOLDOWN_SECONDS=300
# SUB2API_MONITOR_MAX_PER_CYCLE=20
